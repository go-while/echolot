#!/usr/bin/env python3
"""Test stand-in for "sendmail -t": deliver a mail into the Maildir that
FAKESENDMAIL_ROUTES assigns to the recipient's domain, e.g.
FAKESENDMAIL_ROUTES="remailer.test=/tmp/x/rem/Maildir pinger.test=/tmp/x/mail".
Every delivery is logged to FAKESENDMAIL_LOG."""
import email, os, sys, time
from email.utils import getaddresses

routes = dict(r.split("=", 1) for r in os.environ["FAKESENDMAIL_ROUTES"].split())
data = sys.stdin.buffer.read()
msg = email.message_from_bytes(data)
rcpts = [a for _, a in getaddresses(msg.get_all("To", []) + msg.get_all("Cc", []))]
with open(os.environ["FAKESENDMAIL_LOG"], "a") as log:
    for i, r in enumerate(rcpts):
        md = routes.get(r.rsplit("@", 1)[-1].lower())
        if not md:
            log.write(f"DROP {r}\n")
            continue
        name = f"{time.time():.6f}.{os.getpid()}_{i}.fake"
        with open(os.path.join(md, "tmp", name), "wb") as f:
            f.write(data)
        os.rename(os.path.join(md, "tmp", name), os.path.join(md, "new", name))
        log.write(f"{time.strftime('%H:%M:%S')} {r} {msg.get('Subject')!r} {len(data)}B\n")
