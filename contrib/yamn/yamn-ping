#!/bin/sh
# yamn-ping: run yamn the way Echolot runs Mixmaster.
#
# Echolot sends a ping by running its 'mixmaster' program as
#     $mixmaster -m -S -l <nick>
# with the message on stdin and MIXPATH set to its 'mixhome' directory,
# where it has just written a pubring.mix holding that remailer's key.
# Current yamn ignores MIXPATH (and no longer reads a yamn.yml from the
# current directory), so point it at mixhome and its yamn.yml explicitly.
#
# Options added for every ping:
#   -c 1        one copy (older yamn sends 2 by default and ignores
#               stats.num_copies)
#   --nodummy   a ping must not cause extra dummy traffic
#   --keep-headers (only if this yamn has it) Echolot sends some pings with
#               a From: header on purpose, to record whether remailers
#               honour it; newer yamn would strip it.
#
# Set 'mixmaster' => '/path/to/yamn-ping' in pingd.conf.  If the yamn
# binary isn't in PATH, set YAMN, e.g. in the systemd unit:
#     Environment=YAMN=/usr/local/bin/yamn
: "${MIXPATH:?MIXPATH is not set (yamn-ping is meant to be run by Echolot)}"
yamn=${YAMN:-yamn}
if "$yamn" --help 2>&1 | grep -q -- '-keep-headers'; then
	set -- --keep-headers "$@"
fi
exec "$yamn" --dir "$MIXPATH" --config "$MIXPATH/yamn.yml" \
	-c 1 --nodummy "$@"
